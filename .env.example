# Konfigurasi RTSP Kamera / DVR
# Contoh: rtsp://username:password@IP_DVR:554/cam/realmonitor?channel=1&subtype=0
RTSP_URL=rtsp://admin:admin123@192.168.1.15:554/cam/realmonitor?channel=1&subtype=0

# Port Web Server & WebSocket Stream (Unified Port)
PORT=3000

# Waktu tunggu (detik) sebelum mematikan FFmpeg saat tidak ada penonton
STREAM_TIMEOUT_SEC=10
